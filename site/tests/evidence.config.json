 "heavyInteraction": {
  "label": "S05 fill + S04 unroll scroll-scrub (rapid, repeated across pulse..stress)",
  "trigger": "const a=document.getElementById('forecast'), b=document.getElementById('stress'); const start=window.scrollY+a.getBoundingClientRect().top, end=window.scrollY+b.getBoundingClientRect().top; let dir=1; window.scrollTo(0,start); window.__heavyId=setInterval(()=>{window.scrollBy(0,dir*48); const y=window.scrollY; if(y>=end) dir=-1; if(y<=start) dir=1;},16);",
  "stateCheck": "window.__peg.debug().scene + ':' + window.__peg.debug().frames",
  "durationMs": 6000
 }
