        "type": "number"
       },
       "renewables_scale": {
        "type": "number"
       }
      },
      "required": [
       "renewables_scale",
       "demand_growth_pct",
       "heat_wave_c",
       "battery_power_mw",
       "battery_hours",
       "outage_class",
       "outage_pct"
      ],
      "type": "object"
     },
     "scenario": {
      "type": "string"
     }
    },
    "required": [
     "ba",
     "day",
     "scenario",
     "kind",
     "params",
     "lp_text_sha256",
     "expected"
    ],
    "type": "object"
   },
   "minItems": 24,
   "type": "array"
  }
 },
 "required": [
  "schema_version",
  "tags",
  "tolerance_rel",
  "tolerance_abs",
  "tolerance_price_usd_mwh",
  "note",
  "lp_text",
  "parity_keys",
  "vectors"
 ],
 "title": "dispatch_test_vectors",
 "type": "object"
}
