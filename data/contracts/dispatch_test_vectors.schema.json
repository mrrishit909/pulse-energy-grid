{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "additionalProperties": true,
 "properties": {
  "lp_text": {
   "type": "string"
  },
  "note": {
   "type": "string"
  },
  "parity_keys": {
   "items": {
    "type": "string"
   },
   "minItems": 3,
   "type": "array"
  },
  "schema_version": {
   "const": "v1"
  },
  "tags": {
   "additionalProperties": {
    "pattern": "^(OBSERVED|DERIVED|PREDICTED|SIMULATED|SYNTHETIC)(/(OBSERVED|DERIVED|PREDICTED|SIMULATED|SYNTHETIC))*$",
    "type": "string"
   },
   "minProperties": 1,
   "type": "object"
  },
  "tolerance_abs": {
   "type": "number"
  },
  "tolerance_price_usd_mwh": {
   "type": "number"
  },
  "tolerance_rel": {
   "type": "number"
  },
  "vectors": {
   "items": {
    "additionalProperties": true,
    "properties": {
     "ba": {
      "type": "string"
     },
     "day": {
      "type": "string"
     },
     "expected": {
      "additionalProperties": true,
      "properties": {
       "class_energy_mwh": {
        "additionalProperties": false,
        "properties": {
         "battery_discharge": {
          "type": "number"
         },
         "ccgt": {
          "type": "number"
         },
         "coal": {
          "type": "number"
         },
         "hydro": {
          "type": "number"
         },
         "nuclear": {
          "type": "number"
         },
         "peaker": {
          "type": "number"
         }
        },
        "required": [
         "nuclear",
         "ccgt",
         "peaker",
         "hydro",
         "battery_discharge"
        ],
        "type": "object"
       },
       "co2_t": {
        "type": "number"
       },
       "cost_breakdown_usd": {
        "additionalProperties": false,
        "properties": {
         "battery_wear": {
          "type": "number"
         },
         "ccgt": {
          "type": "number"
         },
         "coal": {
          "type": "number"
         },
         "hydro": {
          "type": "number"
         },
         "nuclear": {
          "type": "number"
         },
         "peaker": {
          "type": "number"
         },
         "unserved_voll": {
          "type": "number"
         }
        },
        "required": [
         "nuclear",
         "ccgt",
         "peaker",
         "hydro",
         "battery_wear",
         "unserved_voll"
        ],
        "type": "object"
       },
       "curtailed_mwh": {
        "type": "number"
       },
       "marginal_class": {
        "items": {
         "type": "string"
        },
        "maxItems": 24,
        "minItems": 24,
        "type": "array"
       },
       "max_price_usd_mwh": {
        "type": "number"
       },
       "objective_usd": {
        "type": "number"
       },
       "price_comparable": {
        "type": "boolean"
       },
       "price_usd_mwh": {
        "items": {
         "type": "number"
        },
        "maxItems": 24,
        "minItems": 24,
        "type": "array"
       },
       "soc_mwh": {
        "items": {
         "type": "number"
        },
        "maxItems": 25,
        "minItems": 25,
        "type": "array"
       },
       "unserved_mwh": {
        "type": "number"
       }
      },
      "required": [
       "objective_usd",
       "cost_breakdown_usd",
       "class_energy_mwh",
       "unserved_mwh",
       "curtailed_mwh",
       "soc_mwh",
       "price_usd_mwh",
       "price_comparable",
       "max_price_usd_mwh",
       "co2_t",
       "marginal_class"
      ],
      "type": "object"
     },
     "kind": {
      "enum": [
       "preset",
       "random",
       "stress_unserved",
       "stress_curtailment"
      ]
     },
     "lp_text_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
     },
     "params": {
      "additionalProperties": false,
      "properties": {
       "battery_hours": {
        "type": "number"
       },
       "battery_power_mw": {
        "type": "number"
       },
       "demand_growth_pct": {
        "type": "number"
       },
       "heat_wave_c": {
        "type": "number"
       },
       "outage_class": {
        "type": "string"
       },
