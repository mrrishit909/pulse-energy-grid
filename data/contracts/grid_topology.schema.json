      "type": "number"
     }
    },
    "required": [
     "from",
     "to",
     "r_pu",
     "x_pu",
     "b_pu",
     "rate_a_mva"
    ],
    "type": "object"
   },
   "maxItems": 20,
   "minItems": 20,
   "type": "array"
  },
  "buses": {
   "items": {
    "additionalProperties": true,
    "properties": {
     "base_kv": {
      "type": "number"
     },
     "bs_mvar": {
      "type": "number"
     },
     "gs_mw": {
      "type": "number"
     },
     "id": {
      "type": "integer"
     },
     "pd_mw": {
      "type": "number"
     },
