      "type": "integer"
     }
    },
    "required": [
     "id",
     "type",
     "pd_mw",
     "qd_mvar",
     "gs_mw",
     "bs_mvar",
     "base_kv"
    ],
    "type": "object"
   },
   "maxItems": 14,
   "minItems": 14,
   "type": "array"
  },
  "generators": {
   "items": {
    "additionalProperties": true,
    "properties": {
     "bus": {
      "type": "integer"
     },
     "cost_usd_mwh": {
      "type": "number"
     },
     "pglib_note": {
      "type": "string"
     },
     "pmax_mw": {
      "type": "number"
     },
     "pmin_mw": {
      "type": "number"
     }
